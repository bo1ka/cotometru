---
import { shows } from '../data/shows';

interface Props {
  activeShow?: string;
}

const { activeShow } = Astro.props;
---
<header class="site-header">
  <div class="container header-row">
    <a href="/" class="logo">Coto<span>metru</span></a>
    <nav aria-label="Emisiuni" class="show-nav">
      {shows.map((s) =>
        s.status === 'live' ? (
          <a href={`/${s.slug}/`} class:list={['show-tab', { active: s.slug === activeShow }]}>{s.name}</a>
        ) : (
          <span class="show-tab soon">
            {s.name} <span class="tag">în curând</span>
          </span>
        )
      )}
    </nav>
    <a href="/#cum-functioneaza" class="header-link">Cum funcționează</a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Schimbă tema: deschisă sau închisă">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });
</script>
