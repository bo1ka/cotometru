---
import type { NewsItem } from '../data/types';

interface Props {
  items: NewsItem[];
  title: string;
  compact?: boolean;
  limit?: number;
}

const { items, title, compact = false, limit = 5 } = Astro.props;
const extra = Math.max(0, items.length - limit);
---
<section class="plain" aria-labelledby="news-h" data-news>
  <div class="card-head">
    <h2 id="news-h" class:list={[{ 'h-small': compact }]}>{title}</h2>
    {!compact && <div class="fine no-margin">Titluri verificate de redacție. Linkurile duc la publicația sursă.</div>}
  </div>
  <ul class="news">
    {items.map((n, k) => (
      <li class:list={['news-item', { compact }]} hidden={k >= limit} data-extra={k >= limit ? '' : undefined}>
        <div class="mono news-meta">{[n.date, n.source].filter(Boolean).join(' · ')}</div>
        {n.kind === 'rumor' ? (
          <details class="news-title">
            <summary>Titlu ascuns: posibil spoiler. Apasă ca să îl vezi</summary>
            <a href={n.url} rel="noopener nofollow" target="_blank">{n.title}</a>
          </details>
        ) : (
          <a href={n.url} class="news-title" rel="noopener" target="_blank">{n.title}</a>
        )}
        <span class:list={['badge', n.kind === 'rumor' ? 'badge-rumor' : 'badge-aired']}>
          {n.kind === 'rumor' ? 'Zvon neconfirmat' : 'Difuzat la TV'}
        </span>
      </li>
    ))}
  </ul>
  {extra > 0 && (
    <button type="button" class="more-news" data-more-news>
      Arată încă {extra} {extra === 1 ? 'știre' : 'știri'}
    </button>
  )}
  {!compact && items.some((n) => n.kind === 'rumor') && (
    <p class="fine">Zvonurile nu influențează cotele. Contează doar ce a fost difuzat.</p>
  )}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-more-news]').forEach((button) => {
    button.addEventListener('click', () => {
      button.closest('[data-news]')?.querySelectorAll<HTMLElement>('[data-extra]').forEach((item) => (item.hidden = false));
      button.hidden = true;
    });
  });
</script>
