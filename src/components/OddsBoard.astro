---
import type { Show } from '../data/types';
import { latest, cota, changeLabel, spark, ranked } from '../lib/odds';
import { url } from '../lib/url';

interface Props {
  show: Show;
}

const { show } = Astro.props;
const season = show.season!;
const rows = ranked(season.couples).map((c, k) => ({ c, rank: k + 1, now: latest(c) }));
const lastEpisode = season.episodes.length;
const segments = (now: { t: number; s: number; i: number }) =>
  [
    { key: 't', label: 'Împreună', p: now.t },
    { key: 's', label: 'Separat', p: now.s },
    { key: 'i', label: 'Cu o ispită', p: now.i },
  ].map((seg) => ({ ...seg, tip: `${seg.label} ${seg.p}% · cotă ${cota(seg.p)}` }));
---
<section class="card" aria-labelledby="board-h" data-board={show.slug}>
  <div class="card-head">
    <h2 id="board-h">{season.question}</h2>
    <div class="legend">
      <span><i class="dot bg-t"></i>Împreună</span>
      <span><i class="dot bg-s"></i>Separat</span>
      <span><i class="dot bg-i"></i>Cu o ispită</span>
    </div>
  </div>
  <div class="scroll-x">
    <div class="board">
      <div class="board-row board-headings">
        <div>#</div>
        <div>Cuplu</div>
        <div>Evoluție</div>
        <div>Împreună</div>
        <div>Față de ed. {lastEpisode - 1}</div>
        <div>Scenarii</div>
        <div>Cotă</div>
      </div>
      <div>
        {rows.map(({ c, rank, now }) => (
          <div class="board-row" data-board-row data-couple={c.slug} data-t={now.t}>
            <div class="mono muted" data-cell="rank">{rank}</div>
            <a href={url(`/${show.slug}/${c.slug}/`)} class="couple-name">{c.a.name} & {c.b.name}</a>
            <svg viewBox="0 0 96 28" class="spark" aria-hidden="true">
              <polyline points={spark(c.history.together)} />
            </svg>
            <div class="mono pct" data-cell="pct">{now.t}%</div>
            <div class:list={['mono', 'chg', now.change > 0 ? 'up' : now.change < 0 ? 'down' : '']}>{changeLabel(now.change)}</div>
            <div class="bar" role="group" aria-label="Scenarii">
              {segments(now).map((seg) => (
                <span
                  class:list={['seg', `bg-${seg.key}`]}
                  data-bar={seg.key}
                  style={`width: ${seg.p}%`}
                  tabindex="0"
                  role="img"
                  aria-label={seg.tip}
                  data-tip={seg.tip}
                />
              ))}
            </div>
            <div class="mono" data-cell="cota">{cota(now.t)}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <p class="fine">
    Cote actualizate după fiecare ediție, din predicțiile comunității și din ce s-a văzut la TV. Fără bani și fără mize. Cota
    arată câte puncte aduce o predicție corectă pentru fiecare 100 de puncte de bază. <span data-votes-total hidden></span>
  </p>
</section>
