---
interface Props {
  id: string;
  show: string;
  kind: 'season' | 'night';
  episode?: number;
  question: string;
  options: string[];
  expected?: string;
}

const { id, show, kind, episode, question, options, expected } = Astro.props;
const headingId = `poll-h-${id}`;
---
<section
  class="card"
  aria-labelledby={headingId}
  data-poll={id}
  data-show={show}
  data-kind={kind}
  data-episode={episode}
  hidden={kind === 'night'}
>
  <div class="kicker warm">{kind === 'night' ? `Întrebarea serii · Ediția ${episode}` : 'Întrebarea sezonului'}</div>
  <h2 id={headingId} class="h-small">{question}</h2>
  <div class="options">
    {options.map((o, k) => (
      <button type="button" class="option" data-option={k} aria-pressed="false">
        <span>{o}</span>
        <span class="mono soft" data-share></span>
      </button>
    ))}
  </div>
  <p class="fine" data-note>
    {kind === 'night' ? 'Alege un răspuns. Votul se închide la începutul ediției.' : 'Alege un răspuns ca să vezi ce crede comunitatea.'}
  </p>
  {expected && <p class="fine" data-expected={show}>{expected}</p>}
</section>
