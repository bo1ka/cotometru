---
import type { Couple, Schedule } from '../data/types';
import { nextAiring, describe } from '../lib/schedule';
import { latest, cota, points } from '../lib/odds';
import { site } from '../data/site';

interface Props {
  id: string;
  show: string;
  couple: Couple;
  schedule?: Schedule;
  title?: string;
}

const { id, show, couple, schedule, title = 'Predicția ta: cum pleacă de pe insulă?' } = Astro.props;
const headingId = `pick-${id}`;
const next = schedule ? nextAiring(schedule, Date.now()) : null;
const info = next ? describe(next) : null;
const now = latest(couple);
const options = [
  { key: 't', label: 'Pleacă împreună', p: now.t },
  { key: 's', label: 'Pleacă separat', p: now.s },
  { key: 'i', label: 'Unul pleacă cu o ispită', p: now.i },
];
---
<section class="card" aria-labelledby={headingId} data-picker={id} data-show={show} data-couple={couple.slug}>
  {schedule && (
    <div class="kicker warm" data-schedule={JSON.stringify(schedule)} hidden={!info}>
      Se închide <span data-next="closes">{info?.closes}</span>
    </div>
  )}
  <h2 id={headingId} class="h-small">{title}</h2>
  <div class="options">
    {options.map((o) => (
      <button type="button" class="option option-lg" data-option={o.key} data-gain={points(o.p)} aria-pressed="false">
        <span>{o.label}</span>
        <span class="num strong" data-cota>{cota(o.p)}</span>
      </button>
    ))}
  </div>
  <div class="gain" data-gain-box hidden>
    <div class="soft">Dacă ai dreptate la final</div>
    <div class="num gain-value">+<span data-gain-value></span> puncte</div>
  </div>
  <p class="fine" data-note>
    {site.backend
      ? 'Alege un scenariu. Îl poți schimba până la închidere.'
      : 'Deocamdată predicția se salvează doar pe acest dispozitiv. Clasamentul apare după lansare.'}
  </p>
</section>
