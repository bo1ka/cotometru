---
import type { Show } from '../data/types';
import OddsBoard from './OddsBoard.astro';
import Poll from './Poll.astro';
import NewsList from './NewsList.astro';
import AdSlot from './AdSlot.astro';
import PlatformIcon from './PlatformIcon.astro';
import { nextAiring, describe } from '../lib/schedule';
import { url } from '../lib/url';
import { latest } from '../lib/odds';

interface Props {
  show: Show;
}

const { show } = Astro.props;
const season = show.season!;
const next = season.schedule ? nextAiring(season.schedule, Date.now()) : null;
const info = next ? describe(next) : null;
const expectedTogether = (season.couples.reduce((sum, c) => sum + latest(c).t, 0) / 100).toFixed(1).replace('.', ',');
const units = [
  { key: 'd', label: 'zile' },
  { key: 'h', label: 'ore' },
  { key: 'm', label: 'min' },
  { key: 's', label: 'sec' },
];
---
<section class="hero">
  <div class="hero-main">
    <div class="kicker">Sezonul {season.number} · După ediția {season.episodes.length}</div>
    <h1>{show.name}</h1>
    {show.description && <p class="lead">{show.description}</p>}
    {show.facts && (
      <dl class="facts">
        {show.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {show.links && show.links.length > 0 && (
      <div class="hero-links">
        {show.links.map((l) => (
          <a
            href={l.url}
            class:list={['pill-link', { 'pill-logo': l.logo }]}
            rel="noopener"
            target="_blank"
          >
            {l.logo ? (
              <>
                {l.prefix && <span>{l.prefix}</span>}
                <img src={url(l.logo.dark)} alt={l.logo.alt} class="logo-on-dark" />
                <img src={url(l.logo.light)} alt={l.logo.alt} class="logo-on-light" />
              </>
            ) : (
              l.label
            )}
          </a>
        ))}
      </div>
    )}
  </div>
  {show.image && <img src={url(show.image.src)} alt={show.image.alt} class="hero-image" />}
</section>

<div class="rows">
  <div class="cell">
    <OddsBoard show={show} />
    <AdSlot format="banner" />
  </div>
  <aside class="cell cell-lead">
    {season.schedule && (
      <div class="card next-card" data-schedule={JSON.stringify(season.schedule)} hidden={!info}>
        <div class="kicker muted">Urmează</div>
        <div class="next-title">Ediția <span data-next="number">{info?.number}</span></div>
        <div class="soft" data-next="when">{info?.when}</div>
        <div class="flip" data-flip aria-hidden="true">
          {units.map((u) => (
            <div class="flip-group" data-unit={u.key} hidden={u.key === 'd'}>
              <div class="flip-digits">
                <span class="flip-card">0</span>
                <span class="flip-card">0</span>
              </div>
              <div class="flip-label">{u.label}</div>
            </div>
          ))}
        </div>
        <div class="sr-only" role="timer" data-next="countdown"></div>
        <div class="warm strong">Predicțiile se închid la <span data-next="closesTime">{info?.closesTime}</span></div>
        <a href={url(`/${show.slug}/predictii/`)} class="button">Pune-ți pronosticul</a>
      </div>
    )}
    {season.nightly && season.nightly.length > 0 && season.schedule && (
      <div class="stack" data-night-polls data-night-schedule={JSON.stringify(season.schedule)}>
        {season.nightly.map((q) => (
          <Poll
            id={`${show.slug}-s${season.number}-e${q.episode}`}
            show={show.slug}
            kind="night"
            episode={q.episode}
            question={q.question}
            options={q.options}
          />
        ))}
      </div>
    )}
  </aside>
  <div class="cell">
    {show.news && show.news.length > 0 && <NewsList items={show.news} title="Ce s-a mai aflat" />}
    {show.community && show.community.length > 0 && (
      <section class="plain fill" aria-labelledby="community-h">
        <div class="card-head">
          <h2 id="community-h">Unde comentează lumea</h2>
          <div class="fine no-margin">Pagini oficiale și comunități de fani. Pot conține spoilere.</div>
        </div>
        <div class="link-rows">
          {show.community.map((g) => (
            <a href={g.url} class="link-row" rel="noopener nofollow" target="_blank">
              <span class="mono news-meta platform">
                <PlatformIcon platform={g.platform} />
                {g.platform}
              </span>
              <span class="link-row-main">
                <span class="community-name">{g.name}</span>
                {g.note && <span class="fine no-margin">{g.note}</span>}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
  <aside class="cell">
    <AdSlot format="rectangle" />
    {show.poll && (
      <Poll
        id={`${show.slug}-s${season.number}`}
        show={show.slug}
        kind="season"
        question={show.poll.question}
        options={show.poll.options}
        expected={`Predicțiile indică în jur de ${expectedTogether} cupluri împreună.`}
      />
    )}
    <section class="card outline" id="cum-functioneaza" aria-labelledby="how-h">
      <h2 id="how-h" class="h-small">Cum funcționează</h2>
      <ol class="steps">
        <li>Alegi un scenariu pentru fiecare cuplu, înainte de ediție.</li>
        <li>După ediție, cotele se mișcă în funcție de ce s-a întâmplat.</li>
        <li>La final, predicțiile corecte făcute devreme aduc cele mai multe puncte.</li>
      </ol>
    </section>
  </aside>
</div>
