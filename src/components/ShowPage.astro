---
import type { Show } from '../data/types';
import OddsBoard from './OddsBoard.astro';
import Poll from './Poll.astro';
import NewsList from './NewsList.astro';
import AdSlot from './AdSlot.astro';
import { nextAiring, describe } from '../lib/schedule';

interface Props {
  show: Show;
}

const { show } = Astro.props;
const season = show.season!;
const next = season.schedule ? nextAiring(season.schedule, Date.now()) : null;
const info = next ? describe(next) : null;
const units = [
  { key: 'd', label: 'zile' },
  { key: 'h', label: 'ore' },
  { key: 'm', label: 'min' },
  { key: 's', label: 'sec' },
];
---
<section class="hero">
  <div class="hero-main">
    <div class="kicker">Sezonul {season.number} · După ediția {season.episodes.length}</div>
    <h1>{show.name}</h1>
    {show.image && <img src={show.image.src} alt={show.image.alt} class="hero-image" />}
    {show.description && <p class="lead">{show.description}</p>}
    {show.facts && (
      <dl class="facts">
        {show.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {show.links && show.links.length > 0 && (
      <div class="hero-links">
        {show.links.map((l) => (
          <a href={l.url} class="pill-link" rel="noopener" target="_blank">{l.label}</a>
        ))}
      </div>
    )}
  </div>
  {season.schedule && (
    <div class="card next-card" data-schedule={JSON.stringify(season.schedule)} hidden={!info}>
      <div class="kicker muted">Urmează</div>
      <div class="next-title">Ediția <span data-next="number">{info?.number}</span></div>
      <div class="soft" data-next="when">{info?.when}</div>
      <div class="flip" data-flip aria-hidden="true">
        {units.map((u) => (
          <div class="flip-group" data-unit={u.key} hidden={u.key === 'd'}>
            <div class="flip-digits">
              <span class="flip-card">0</span>
              <span class="flip-card">0</span>
            </div>
            <div class="flip-label">{u.label}</div>
          </div>
        ))}
      </div>
      <div class="sr-only" role="timer" data-next="countdown"></div>
      <div class="warm strong">Predicțiile se închid la <span data-next="closesTime">{info?.closesTime}</span></div>
      <a href={`/${show.slug}/predictii/`} class="button">Fă-ți predicțiile</a>
    </div>
  )}
</section>

<div class="columns">
  <div class="col-main">
    <OddsBoard show={show} />
  </div>
  <aside class="col-side">
    {show.poll && <Poll id={`${show.slug}-s${season.number}`} question={show.poll.question} options={show.poll.options} />}
    <section class="card outline" id="cum-functioneaza" aria-labelledby="how-h">
      <h2 id="how-h" class="h-small">Cum funcționează</h2>
      <ol class="steps">
        <li>Alegi un scenariu pentru fiecare cuplu, înainte de ediție.</li>
        <li>După ediție, cotele se mișcă în funcție de ce s-a întâmplat.</li>
        <li>La final, predicțiile corecte făcute devreme aduc cele mai multe puncte.</li>
      </ol>
    </section>
    {show.community && show.community.length > 0 && (
      <section class="card outline" aria-labelledby="community-h">
        <h2 id="community-h" class="h-small">Comunitate</h2>
        <ul class="link-list">
          {show.community.map((g) => (
            <li>
              <a href={g.url} rel="noopener nofollow" target="_blank">{g.name}</a>
              <span class="tag">{g.platform}</span>
              {g.note && <div class="fine no-margin">{g.note}</div>}
            </li>
          ))}
        </ul>
        <p class="fine">Grupuri, pagini și creatori independenți care comentează emisiunea. Pot conține spoilere și zvonuri.</p>
      </section>
    )}
    <AdSlot format="rectangle" />
  </aside>
</div>

<div class="block">
  <AdSlot format="banner" />
</div>

{show.news && show.news.length > 0 && (
  <div class="block">
    <NewsList items={show.news} title="Știri despre emisiune" />
  </div>
)}
